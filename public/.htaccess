# Apache Configuration for Kalix Scort - Single Page Application

# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Consolidate the root URL with the primary Bucaramanga landing page
  RewriteRule ^$ /bucaramanga [R=301,L]

  # Serve index.html without changing the URL
  RewriteRule ^index\.html$ - [L]

  # Don't rewrite requests for existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrite all other requests to index.html (SPA routing)
  RewriteRule . /index.html [L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
  AddEncoding gzip .gz
  AddType application/gzip .gz
</IfModule>

# Browser Caching - Static Assets
<IfModule mod_expires.c>
  ExpiresActive On

  # Images (1 year)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS & JavaScript (1 year)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # HTML (no cache - for SPA index.html)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
  # Cache control for static assets
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # No cache for HTML and JSON
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Remove server information
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Force HTTPS (uncomment if SSL is enabled on Hostinger)
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} off
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Prevent directory listing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Error handling (optional - returns 404.html if it exists)
# ErrorDocument 404 /index.html
